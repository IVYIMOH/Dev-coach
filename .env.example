# Server Port
PORT=3000

# Anthropic API Configuration
# If left empty, Dev Coach runs in built-in mock mode for zero-config testing and offline dev
ANTHROPIC_API_KEY=

# Model ID (defaults to claude-sonnet-5-5 if unset)
MODEL=claude-sonnet-5-5

# Optional Talking-Head Video Provider Keys (for POST /api/avatar-video stub)
# Set either DID_API_KEY or HEYGEN_API_KEY to activate video avatar generation
DID_API_KEY=
HEYGEN_API_KEY=

